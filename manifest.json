{
  "manifest_version": 3,
  "name": "WAG Inbox",
  "version": "0.3.2",
  "description": "A filtered inbox of the group chats you pick, drawn on top of your team's chat console.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "WAG Inbox settings"
  }
}
